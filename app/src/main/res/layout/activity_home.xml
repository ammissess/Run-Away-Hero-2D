<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home">

    <!-- ===== FAR CLOUDS (nhỏ, mờ, chạy chậm) ===== --> <ImageView
    android:id="@+id/clouds_far_1"
    android:layout_width="match_parent"
    android:layout_height="90dp"
    android:layout_gravity="top"
    android:layout_marginTop="16dp"
    android:alpha="0.75"
    android:scaleType="fitXY"
    android:src="@drawable/bg_home_clouds" />

    <ImageView
        android:id="@+id/clouds_far_2"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_gravity="top"
        android:layout_marginTop="16dp"
        android:alpha="0.75"
        android:scaleType="fitXY"
        android:src="@drawable/bg_home_clouds" /> <!-- ===== MID CLOUDS ===== --> <ImageView
    android:id="@+id/clouds_mid_1"
    android:layout_width="match_parent"
    android:layout_height="110dp"
    android:layout_gravity="top"
    android:layout_marginTop="52dp"
    android:alpha="0.88"
    android:scaleType="fitXY"
    android:src="@drawable/bg_home_clouds" />

    <ImageView
        android:id="@+id/clouds_mid_2"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_gravity="top"
        android:layout_marginTop="52dp"
        android:alpha="0.88"
        android:scaleType="fitXY"
        android:src="@drawable/bg_home_clouds" /> <!-- ===== NEAR CLOUDS ===== --> <ImageView
    android:id="@+id/clouds_near_1"
    android:layout_width="match_parent"
    android:layout_height="130dp"
    android:layout_gravity="top"
    android:layout_marginTop="88dp"
    android:alpha="1.0"
    android:scaleType="fitXY"
    android:src="@drawable/bg_home_clouds" />

    <ImageView
        android:id="@+id/clouds_near_2"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_gravity="top"
        android:layout_marginTop="88dp"
        android:alpha="1.0"
        android:scaleType="fitXY"
        android:src="@drawable/bg_home_clouds" />
    <!-- NỘI DUNG CHÍNH (bố cục ngang khi xoay ngang) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="24dp">

        <!-- CỘT TRÁI: Title + Start -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <!-- HOME title -->
            <TextView
                android:id="@+id/home_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="48dp"
                android:gravity="center"
                android:text="HOME"
                android:textColor="@android:color/white"
                android:textSize="96sp"
                android:textStyle="bold" />

            <!-- Start button -->
            <Button
                android:id="@+id/button_start"
                android:layout_width="200dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:backgroundTint="#1976D2"
                android:text="START GAME"
                android:textColor="@android:color/white"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- CỘT PHẢI: Options -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Chọn cấp độ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Chọn cấp độ"
                android:textColor="#333333"
                android:textSize="20sp" />

            <Spinner
                android:id="@+id/spinner_level"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_spinner_border" />

            <!-- Chọn nhân vật -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Chọn nhân vật"
                android:textColor="#333333"
                android:textSize="20sp" />

            <Spinner
                android:id="@+id/spinner_character"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_spinner_border" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
