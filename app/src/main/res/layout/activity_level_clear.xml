<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clear_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home">

    <!-- ===== FAR CLOUDS (chậm, mờ) ===== -->
    <ImageView
        android:id="@+id/clouds_far_1"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_gravity="top"
        android:layout_marginTop="16dp"
        android:alpha="0.75"
        android:scaleType="fitXY"
        android:src="@drawable/bg_home_clouds" />

    <ImageView
        android:id="@+id/clouds_far_2"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_gravity="top"
        android:layout_marginTop="16dp"
        android:alpha="0.75"
        android:scaleType="fitXY"
        android:src="@drawable/bg_home_clouds" />

    <!-- ===== MID CLOUDS ===== -->
    <ImageView
        android:id="@+id/clouds_mid_1"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_gravity="top"
        android:layout_marginTop="52dp"
        android:alpha="0.88"
        android:scaleType="fitXY"
        android:src="@drawable/bg_home_clouds" />

    <ImageView
        android:id="@+id/clouds_mid_2"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_gravity="top"
        android:layout_marginTop="52dp"
        android:alpha="0.88"
        android:scaleType="fitXY"
        android:src="@drawable/bg_home_clouds" />

    <!-- ===== NEAR CLOUDS (nhanh, rõ) ===== -->
    <ImageView
        android:id="@+id/clouds_near_1"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_gravity="top"
        android:layout_marginTop="88dp"
        android:alpha="1.0"
        android:scaleType="fitXY"
        android:src="@drawable/bg_home_clouds" />

    <ImageView
        android:id="@+id/clouds_near_2"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_gravity="top"
        android:layout_marginTop="88dp"
        android:alpha="1.0"
        android:scaleType="fitXY"
        android:src="@drawable/bg_home_clouds" />

    <!-- ===== FOREGROUND: nội dung cũ giữ nguyên ID ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textStyle="bold"
            android:textSize="28sp"
            android:textColor="@android:color/white"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnNextLevel"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:text="Next Level"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnReplay"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:text="Replay"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnRanking"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:text="Ranking"/>
    </LinearLayout>
</FrameLayout>
