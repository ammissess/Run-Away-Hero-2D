<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home">

    <!-- Có thể thêm layer mây giống màn Home nếu muốn -->
    <!-- Far Clouds -->
    <ImageView
        android:id="@+id/clouds_far_1"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_gravity="top"
        android:layout_marginTop="16dp"
        android:scaleType="fitXY"
        android:src="@drawable/bg_home_clouds"
        android:alpha="0.75"/>

    <ImageView
        android:id="@+id/clouds_far_2"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_gravity="top"
        android:layout_marginTop="16dp"
        android:scaleType="fitXY"
        android:src="@drawable/bg_home_clouds"
        android:alpha="0.75"/>

    <!-- Mid Clouds -->
    <ImageView
        android:id="@+id/clouds_mid_1"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_gravity="top"
        android:layout_marginTop="52dp"
        android:scaleType="fitXY"
        android:src="@drawable/bg_home_clouds"
        android:alpha="0.88"/>

    <ImageView
        android:id="@+id/clouds_mid_2"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_gravity="top"
        android:layout_marginTop="52dp"
        android:scaleType="fitXY"
        android:src="@drawable/bg_home_clouds"
        android:alpha="0.88"/>

    <!-- Near Clouds -->
    <ImageView
        android:id="@+id/clouds_near_1"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_gravity="top"
        android:layout_marginTop="88dp"
        android:scaleType="fitXY"
        android:src="@drawable/bg_home_clouds"
        android:alpha="1.0"/>

    <ImageView
        android:id="@+id/clouds_near_2"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_gravity="top"
        android:layout_marginTop="88dp"
        android:scaleType="fitXY"
        android:src="@drawable/bg_home_clouds"
        android:alpha="1.0"/>

    <!-- Nội dung Game Over -->
    <LinearLayout
        android:orientation="vertical"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Game Over"
            android:textSize="56sp"
            android:textColor="#FFCC33"
            android:textStyle="bold"
            android:layout_marginBottom="40dp"/>

        <Button
            android:id="@+id/btn_play_again"
            android:layout_width="200dp"
            android:layout_height="56dp"
            android:text="Play Again"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#FFCC33"
            android:textColor="#000000"/>

        <Button
            android:id="@+id/btn_quit"
            android:layout_width="200dp"
            android:layout_height="56dp"
            android:text="Quit"
            android:backgroundTint="#FFCC33"
            android:textColor="#000000"/>
    </LinearLayout>
</FrameLayout>
