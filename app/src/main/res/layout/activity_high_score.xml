<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/highscore_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home">

    <!-- Clouds far -->
    <ImageView
        android:id="@+id/clouds_far_1"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_gravity="top"
        android:layout_marginTop="16dp"
        android:alpha="0.75"
        android:scaleType="fitXY"
        android:src="@drawable/bg_home_clouds"/>
    <ImageView
        android:id="@+id/clouds_far_2"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_gravity="top"
        android:layout_marginTop="16dp"
        android:alpha="0.75"
        android:scaleType="fitXY"
        android:src="@drawable/bg_home_clouds"/>

    <!-- Clouds mid -->
    <ImageView
        android:id="@+id/clouds_mid_1"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_gravity="top"
        android:layout_marginTop="52dp"
        android:alpha="0.88"
        android:scaleType="fitXY"
        android:src="@drawable/bg_home_clouds"/>
    <ImageView
        android:id="@+id/clouds_mid_2"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_gravity="top"
        android:layout_marginTop="52dp"
        android:alpha="0.88"
        android:scaleType="fitXY"
        android:src="@drawable/bg_home_clouds"/>

    <!-- Clouds near -->
    <ImageView
        android:id="@+id/clouds_near_1"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_gravity="top"
        android:layout_marginTop="88dp"
        android:alpha="1.0"
        android:scaleType="fitXY"
        android:src="@drawable/bg_home_clouds"/>
    <ImageView
        android:id="@+id/clouds_near_2"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_gravity="top"
        android:layout_marginTop="88dp"
        android:alpha="1.0"
        android:scaleType="fitXY"
        android:src="@drawable/bg_home_clouds"/>

    <!-- Content -->
    <LinearLayout
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/tvTitle"
            android:text="HIGH SCORES"
            android:textStyle="bold"
            android:textSize="36sp"
            android:textColor="@android:color/white"
            android:layout_marginBottom="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvScores"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="12dp"/>

        <Button
            android:id="@+id/btnBackHome"
            android:layout_width="200dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:backgroundTint="#1976D2"
            android:text="BACK HOME"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
</FrameLayout>
