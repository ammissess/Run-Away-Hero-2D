<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_app"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_app"
        android:supportsRtl="true"
        android:theme="@style/Theme.Game2DFighting">
        <!-- MainActivity: Launcher -->
        <activity
            android:name=".view.MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- HomeActivity: Trang chủ -->
        <activity
            android:name=".view.HomeActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- Level1Activity: Level 1 -->
        <activity
            android:name=".view.Level1Activity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity android:name=".view.Level2Activity"
            android:exported="false" />

        <activity android:name=".view.Level3Activity"
            android:exported="false" />
        <activity
            android:name=".view.GameOverActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity android:name=".view.HighScoreActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"/>

    </application>

</manifest>